<ui:UiPage x:Class="RinsTrap.UI.Elements.Settings.Pages.MultiInstancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:RinsTrap.UI.Elements.Controls"
      d:DataContext="{d:DesignInstance Type=MultiInstanceViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="MultiInstancePage"
      Scrollable="True">

    <ui:UiPage.Resources>
        <ContextMenu x:Key="AccountContextMenu">
            <MenuItem Header="Select All" Command="{Binding SelectAllAccountsCommand}" />
            <MenuItem Header="Delete Selected" Command="{Binding DeleteSelectedAccountsCommand}" />
            <Separator />
            <MenuItem Header="Launch Selected" Command="{Binding LaunchSelectedAccountsCommand}" />
        </ContextMenu>
        <ContextMenu x:Key="InstanceContextMenu">
            <MenuItem Header="Select All" Click="SelectAllInstances_Click" />
            <MenuItem Header="Kill Selected" Click="KillSelectedInstances_Click" />
            <Separator />
            <MenuItem Header="Kill All" Command="{Binding KillAllInstancesCommand}" />
        </ContextMenu>
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: Accounts + Actions -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Accounts" FontSize="16" FontWeight="SemiBold" />
            <ListBox x:Name="AccountListBox"
                     ItemsSource="{Binding Accounts}" 
                     SelectedItem="{Binding SelectedAccount}"
                     DisplayMemberPath="Name"
                     MinHeight="100" MaxHeight="180"
                     Margin="0,6,0,0"
                     ContextMenu="{StaticResource AccountContextMenu}" />

            <!-- Account Buttons -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="Add" Icon="Add24" HorizontalAlignment="Stretch" Margin="0,0,3,0"
                           Command="{Binding AddAccountCommand}" />
                <ui:Button Grid.Column="1" Content="Delete" Icon="Delete24" HorizontalAlignment="Stretch" Margin="3,0,0,0"
                           Appearance="Danger" IsEnabled="{Binding IsAccountSelected}"
                           Command="{Binding DeleteAccountCommand}" />
            </Grid>

            <!-- Quick Actions -->
            <Border Margin="0,10,0,0" Padding="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Launch" Icon="Play24" HorizontalAlignment="Stretch" Margin="0,0,3,0"
                                   IsEnabled="{Binding IsAccountSelected}" Command="{Binding LaunchInstanceCommand}" />
                        <ui:Button Grid.Column="1" Content="All" Icon="Play24" HorizontalAlignment="Stretch" Margin="3,0,0,0"
                                   Command="{Binding LaunchAllInstancesCommand}" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Restart" Icon="ArrowSync24" HorizontalAlignment="Stretch" Margin="0,0,3,0"
                                   Command="{Binding RestartAllInstancesCommand}" />
                        <ui:Button Grid.Column="1" Content="Kill All" Icon="Dismiss24" HorizontalAlignment="Stretch" Margin="3,0,0,0"
                                   Appearance="Danger" Command="{Binding KillAllInstancesCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Account Details -->
            <Border Margin="0,10,0,0" Padding="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                    IsEnabled="{Binding IsAccountSelected}">
                <StackPanel>
                    <TextBlock Text="Details" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding SelectedAccount.Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Account name" Margin="0,2,0,6" />
                    <TextBlock Text="Description" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding SelectedAccount.Description, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" Margin="0,2,0,6" />
                    <TextBlock Text="Launch Args" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding SelectedAccount.LaunchArgs, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="-noconsole" Margin="0,2,0,6" />
                    <controls:OptionControl Header="Auto-Launch" Description="Launch with All">
                        <ui:ToggleSwitch IsChecked="{Binding SelectedAccount.AutoLaunch, Mode=TwoWay}" />
                    </controls:OptionControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- RIGHT: Instances + Features -->
        <StackPanel Grid.Column="1">
            <!-- Running Instances -->
            <TextBlock Text="Running Instances" FontSize="16" FontWeight="SemiBold" />
            <DataGrid x:Name="InstancesDataGrid"
                      ItemsSource="{Binding RunningInstances}"
                      Margin="0,6,0,0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Extended"
                      MinHeight="80" MaxHeight="160"
                      ContextMenu="{StaticResource InstanceContextMenu}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" />
                    <DataGridTextColumn Header="Time" Binding="{Binding Runtime}" Width="70" />
                    <DataGridTemplateColumn Header="" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="X" Icon="Dismiss16" Appearance="Danger"
                                           Tag="{Binding ProcessId}" Click="KillInstance_Click" Padding="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <ui:Button Content="Refresh" Icon="ArrowSync24" Margin="0,6,0,0" HorizontalAlignment="Left"
                       Command="{Binding RefreshInstancesCommand}" />

            <!-- Features Grid -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Anti-AFK -->
                <Border Grid.Row="0" Grid.Column="0" Padding="8" Margin="0,0,6,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Anti-AFK" FontSize="12" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding AntiAfkEnabled, Mode=TwoWay}" HorizontalAlignment="Right" Width="40" Height="20" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding AntiAfkEnabled}">
                            <Slider Width="100" Minimum="30" Maximum="600" Value="{Binding AntiAfkIntervalSeconds}" TickFrequency="30" IsSnapToTickEnabled="True" />
                            <TextBlock Text="{Binding AntiAfkIntervalText}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10" />
                        </StackPanel>
                        <ui:Button Content="Toggle" Icon="Clock16" Margin="0,4,0,0" HorizontalAlignment="Left" Padding="8,4"
                                   Command="{Binding ToggleAntiAfkCommand}" />
                    </StackPanel>
                </Border>

                <!-- Screenshots -->
                <Border Grid.Row="0" Grid.Column="1" Padding="8" Margin="6,0,0,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Screenshots" FontSize="12" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding ScreenshotsEnabled, Mode=TwoWay}" HorizontalAlignment="Right" Width="40" Height="20" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding ScreenshotIntervals}" SelectedItem="{Binding ScreenshotIntervalSeconds}" Width="80" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:Button Content="Now" Icon="Camera16" Padding="6,3" Margin="0,0,4,0"
                                       Command="{Binding CaptureNowCommand}" />
                            <ui:Button Content="Browse" Icon="FolderOpen16" Padding="6,3"
                                       Command="{Binding BrowseScreenshotPathCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Auto-Relaunch -->
                <Border Grid.Row="1" Grid.Column="0" Padding="8" Margin="0,0,6,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Auto-Relaunch" FontSize="12" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding AutoRelaunchEnabled, Mode=TwoWay}" HorizontalAlignment="Right" Width="40" Height="20" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding AutoRelaunchEnabled}">
                            <Slider Width="80" Minimum="1" Maximum="30" Value="{Binding AutoRelaunchDelaySeconds}" />
                            <TextBlock Text="{Binding AutoRelaunchDelayText}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Anti-Detection -->
                <Border Grid.Row="1" Grid.Column="1" Padding="8" Margin="6,0,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Anti-Detection" FontSize="12" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding AntiDetectionEnabled, Mode=TwoWay}" HorizontalAlignment="Right" Width="40" Height="20" />
                        </Grid>
                        <StackPanel Margin="0,4,0,0" IsEnabled="{Binding AntiDetectionEnabled}">
                            <controls:OptionControl Header="User ID" Description="">
                                <ui:ToggleSwitch IsChecked="{Binding RandomizeUserId, Mode=TwoWay}" Width="40" Height="20" />
                            </controls:OptionControl>
                            <controls:OptionControl Header="Session ID" Description="">
                                <ui:ToggleSwitch IsChecked="{Binding RandomizeSessionId, Mode=TwoWay}" Width="40" Height="20" />
                            </controls:OptionControl>
                            <controls:OptionControl Header="Hardware ID" Description="">
                                <ui:ToggleSwitch IsChecked="{Binding SpoofHardwareId, Mode=TwoWay}" Width="40" Height="20" />
                            </controls:OptionControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Row: Discord + Dashboard + Logging -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Discord -->
                <Border Grid.Column="0" Padding="8" Margin="0,0,6,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Discord" FontSize="12" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding DiscordRichPresenceEnabled, Mode=TwoWay}" HorizontalAlignment="Right" Width="40" Height="20" />
                        </Grid>
                        <ui:TextBox Text="{Binding DiscordAppId}" PlaceholderText="App ID" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Dashboard -->
                <Border Grid.Column="1" Padding="8" Margin="6,0,6,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Dashboard" FontSize="12" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding WebDashboardEnabled, Mode=TwoWay}" HorizontalAlignment="Right" Width="40" Height="20" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding WebDashboardPort}" Width="50" />
                            <ui:Button Grid.Column="1" Content="Open" Icon="Globe16" Padding="6,3" Margin="4,0,0,0"
                                       Click="OpenDashboard_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Logging -->
                <Border Grid.Column="2" Padding="8" Margin="6,0,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Logging" FontSize="12" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding LoggingEnabled, Mode=TwoWay}" HorizontalAlignment="Right" Width="40" Height="20" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:Button Content="Clear" Icon="Delete16" Padding="6,3" Margin="0,0,4,0"
                                       Command="{Binding ClearLogsCommand}" />
                            <ui:Button Content="Export" Icon="ArrowDownload16" Padding="6,3"
                                       Command="{Binding ExportLogsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Mini Log -->
            <Border Margin="0,10,0,0" Padding="6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="80">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding InstanceName}" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</ui:UiPage>
