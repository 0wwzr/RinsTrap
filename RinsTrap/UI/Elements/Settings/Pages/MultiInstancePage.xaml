<ui:UiPage x:Class="RinsTrap.UI.Elements.Settings.Pages.MultiInstancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:RinsTrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:RinsTrap.UI.ViewModels.Settings"
      d:DataContext="{d:DesignInstance Type=MultiInstanceViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="MultiInstancePage"
      Scrollable="True">

    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Multi-Instance Manager" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Launch and manage multiple Roblox instances" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Accounts Section -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Account List -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Accounts" FontSize="16" FontWeight="SemiBold" />
                <ListBox x:Name="AccountListBox"
                         ItemsSource="{Binding Accounts}" 
                         SelectedItem="{Binding SelectedAccount}"
                         DisplayMemberPath="Name"
                         Margin="0,8,0,0"
                         MinHeight="120"
                         ContextMenu="{StaticResource AccountContextMenu}" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" Content="Add" Icon="Add28" 
                               HorizontalAlignment="Stretch" Margin="0,0,4,0"
                               Command="{Binding AddAccountCommand}" />
                    <ui:Button Grid.Column="1" Content="Delete" Icon="Delete28" 
                               HorizontalAlignment="Stretch" Margin="4,0,4,0"
                               Appearance="Danger"
                               IsEnabled="{Binding IsAccountSelected}"
                               Command="{Binding DeleteAccountCommand}" />
                    <ui:Button Grid.Column="2" Content="Launch" Icon="Play24" 
                               HorizontalAlignment="Stretch" Margin="4,0,4,0"
                               IsEnabled="{Binding IsAccountSelected}"
                               Command="{Binding LaunchInstanceCommand}" />
                    <ui:Button Grid.Column="3" Content="All" Icon="Play24" 
                               HorizontalAlignment="Stretch" Margin="4,0,0,0"
                               Command="{Binding LaunchAllInstancesCommand}" />
                </Grid>
            </StackPanel>

            <!-- Account Details -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0"
                        IsEnabled="{Binding IsAccountSelected}">
                <TextBlock Text="Account Details" FontSize="16" FontWeight="SemiBold" />

                <TextBlock Text="Name" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Text="{Binding SelectedAccount.Name, UpdateSourceTrigger=PropertyChanged}" 
                            PlaceholderText="e.g., Main Account" />

                <TextBlock Text="Description (Optional)" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Text="{Binding SelectedAccount.Description, UpdateSourceTrigger=PropertyChanged}" 
                            PlaceholderText="e.g., My main trading account"
                            AcceptsReturn="True" TextWrapping="Wrap" />

                <TextBlock Text="Launch Arguments" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Text="{Binding SelectedAccount.LaunchArgs, UpdateSourceTrigger=PropertyChanged}" 
                            PlaceholderText="e.g., -noconsole" />

                <controls:OptionControl Header="Auto-Launch" Margin="0,12,0,0"
                                       Description="Include when launching all">
                    <ui:ToggleSwitch IsChecked="{Binding SelectedAccount.AutoLaunch, Mode=TwoWay}" />
                </controls:OptionControl>

                <Border Background="{DynamicResource ControlStrongFillColorDefaultBrush}" 
                        CornerRadius="4" Padding="8" Margin="0,12,0,0">
                    <TextBlock Text="{Binding SelectedAccount.Status}" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Running Instances Header -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Grid>
                <TextBlock Text="Running Instances" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Refresh" Icon="ArrowSync24" Margin="0,0,8,0"
                               Command="{Binding RefreshInstancesCommand}" />
                    <ui:Button Content="Kill All" Icon="Dismiss24" 
                               Appearance="Danger"
                               Command="{Binding KillAllInstancesCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Running Instances List -->
        <DataGrid Grid.Row="3" 
                  x:Name="InstancesDataGrid"
                  ItemsSource="{Binding RunningInstances}"
                  Margin="0,8,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  ContextMenu="{StaticResource InstanceContextMenu}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                <DataGridTextColumn Header="Runtime" Binding="{Binding Runtime}" Width="80" />
                <DataGridTemplateColumn Header="Action" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="Kill" Icon="Dismiss16" 
                                       Appearance="Danger"
                                       Tag="{Binding ProcessId}"
                                       Click="KillInstance_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Anti-AFK Section -->
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="Anti-AFK" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Prevents automatic disconnection due to inactivity" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />

            <controls:OptionControl Header="Enable Anti-AFK" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <ui:ToggleSwitch IsChecked="{Binding AntiAfkEnabled, Mode=TwoWay}" />
                    <TextBlock Text="{Binding AntiAfkStatusText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </controls:OptionControl>

            <controls:OptionControl Header="Interval" IsEnabled="{Binding AntiAfkEnabled}">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="30" Maximum="600" Value="{Binding AntiAfkIntervalSeconds}" TickFrequency="30" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding AntiAfkIntervalText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </controls:OptionControl>

            <controls:OptionControl Header="Simulate Mouse Movement" IsEnabled="{Binding AntiAfkEnabled}">
                <ui:ToggleSwitch IsChecked="{Binding AntiAfkSimulateMouse, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="Simulate Key Press" IsEnabled="{Binding AntiAfkEnabled}">
                <StackPanel Orientation="Horizontal">
                    <ui:ToggleSwitch IsChecked="{Binding AntiAfkSimulateKey, Mode=TwoWay}" />
                    <ComboBox ItemsSource="{Binding AntiAfkKeys}" SelectedItem="{Binding AntiAfkKeyToSend}" Margin="8,0,0,0" Width="80" IsEnabled="{Binding AntiAfkSimulateKey}" />
                </StackPanel>
            </controls:OptionControl>

            <ui:Button Content="Toggle Anti-AFK" Icon="Clock24" Margin="0,8,0,0" Command="{Binding ToggleAntiAfkCommand}" />
        </StackPanel>

        <!-- Screenshots Section -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <TextBlock Text="Instance Screenshots" FontSize="16" FontWeight="SemiBold" />

            <controls:OptionControl Header="Enable Screenshots"
                                   Description="Automatically capture screenshots of running instances">
                <ui:ToggleSwitch IsChecked="{Binding ScreenshotsEnabled, Mode=TwoWay}" />
            </controls:OptionControl>

            <TextBlock Text="Interval" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding ScreenshotIntervals}" SelectedItem="{Binding ScreenshotIntervalSeconds}" Width="120" HorizontalAlignment="Left" />

            <TextBlock Text="Save Location" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Text="{Binding ScreenshotSavePath}" 
                            PlaceholderText="Default: AppData/Local/RinsTrap/Screenshots" IsReadOnly="True" />
                <ui:Button Grid.Column="1" Content="Browse" Icon="FolderOpen24" Margin="8,0,0,0" Command="{Binding BrowseScreenshotPathCommand}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="Capture Now" Icon="Camera24" Margin="0,0,8,0" Command="{Binding CaptureNowCommand}" />
                <TextBlock Text="{Binding ScreenshotStatusText}" VerticalAlignment="Center" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Logging Section -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Grid>
                <TextBlock Text="Instance Logging" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Clear" Icon="Delete24" Margin="0,0,8,0" Command="{Binding ClearLogsCommand}" />
                    <ui:Button Content="Export" Icon="ArrowDownload24" Margin="0,0,8,0" Command="{Binding ExportLogsCommand}" />
                    <ui:ToggleSwitch IsChecked="{Binding LoggingEnabled, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                    CornerRadius="4" Padding="8" Margin="0,8,0,0" MaxHeight="150">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding InstanceName}" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="10" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>

    <!-- Context Menus -->
    <ui:UiPage.Resources>
        <ContextMenu x:Key="AccountContextMenu">
            <MenuItem Header="Select All" Command="{Binding SelectAllAccountsCommand}" />
            <MenuItem Header="Delete Selected" Command="{Binding DeleteSelectedAccountsCommand}" />
            <Separator />
            <MenuItem Header="Launch Selected" Command="{Binding LaunchSelectedAccountsCommand}" />
        </ContextMenu>

        <ContextMenu x:Key="InstanceContextMenu">
            <MenuItem Header="Select All" Click="SelectAllInstances_Click" />
            <MenuItem Header="Kill Selected" Click="KillSelectedInstances_Click" />
            <Separator />
            <MenuItem Header="Kill All" Command="{Binding KillAllInstancesCommand}" />
        </ContextMenu>
    </ui:UiPage.Resources>
</ui:UiPage>
