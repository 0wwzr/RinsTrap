<ui:UiPage x:Class="RinsTrap.UI.Elements.Settings.Pages.MultiInstancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:RinsTrap.UI.Elements.Controls"
      d:DataContext="{d:DesignInstance Type=MultiInstanceViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="900"
      Title="MultiInstancePage"
      Scrollable="True">

    <ui:UiPage.Resources>
        <ContextMenu x:Key="AccountContextMenu">
            <MenuItem Header="Select All" Command="{Binding SelectAllAccountsCommand}" />
            <MenuItem Header="Delete Selected" Command="{Binding DeleteSelectedAccountsCommand}" />
            <Separator />
            <MenuItem Header="Launch Selected" Command="{Binding LaunchSelectedAccountsCommand}" />
        </ContextMenu>
        <ContextMenu x:Key="InstanceContextMenu">
            <MenuItem Header="Select All" Click="SelectAllInstances_Click" />
            <MenuItem Header="Kill Selected" Click="KillSelectedInstances_Click" />
            <Separator />
            <MenuItem Header="Kill All" Command="{Binding KillAllInstancesCommand}" />
        </ContextMenu>
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN -->
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <!-- Header -->
            <TextBlock Text="Accounts" FontSize="18" FontWeight="SemiBold" />

            <!-- Account List -->
            <ListBox x:Name="AccountListBox"
                     ItemsSource="{Binding Accounts}" 
                     SelectedItem="{Binding SelectedAccount}"
                     DisplayMemberPath="Name"
                     MinHeight="140" MaxHeight="220"
                     Margin="0,8,0,0"
                     ContextMenu="{StaticResource AccountContextMenu}" />

            <!-- Account Buttons -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="Add Account" Icon="Add24" HorizontalAlignment="Stretch" Margin="0,0,5,0"
                           Command="{Binding AddAccountCommand}" />
                <ui:Button Grid.Column="1" Content="Delete" Icon="Delete24" HorizontalAlignment="Stretch" Margin="5,0,0,0"
                           Appearance="Danger" IsEnabled="{Binding IsAccountSelected}"
                           Command="{Binding DeleteAccountCommand}" />
            </Grid>

            <!-- Account Details -->
            <Border Margin="0,14,0,0" Padding="12" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                    IsEnabled="{Binding IsAccountSelected}">
                <StackPanel>
                    <TextBlock Text="Account Details" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <TextBlock Text="Name" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding SelectedAccount.Name, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="e.g., Main Account" />

                    <TextBlock Text="Description" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding SelectedAccount.Description, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="Optional description" />

                    <TextBlock Text="Launch Arguments" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Text="{Binding SelectedAccount.LaunchArgs, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="-noconsole" />

                    <controls:OptionControl Header="Auto-Launch" Margin="0,12,0,0">
                        <ui:ToggleSwitch IsChecked="{Binding SelectedAccount.AutoLaunch, Mode=TwoWay}" />
                    </controls:OptionControl>
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <Border Margin="0,14,0,0" Padding="12" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Launch" Icon="Play24" HorizontalAlignment="Stretch" Margin="0,0,5,0"
                                   IsEnabled="{Binding IsAccountSelected}" Command="{Binding LaunchInstanceCommand}" />
                        <ui:Button Grid.Column="1" Content="Launch All" Icon="Play24" HorizontalAlignment="Stretch" Margin="5,0,0,0"
                                   Command="{Binding LaunchAllInstancesCommand}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Restart All" Icon="ArrowSync24" HorizontalAlignment="Stretch" Margin="0,0,5,0"
                                   Command="{Binding RestartAllInstancesCommand}" />
                        <ui:Button Grid.Column="1" Content="Kill All" Icon="Dismiss24" HorizontalAlignment="Stretch" Margin="5,0,0,0"
                                   Appearance="Danger" Command="{Binding KillAllInstancesCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- RIGHT COLUMN -->
        <StackPanel Grid.Column="1">
            <!-- Running Instances -->
            <TextBlock Text="Running Instances" FontSize="18" FontWeight="SemiBold" />
            <DataGrid x:Name="InstancesDataGrid"
                      ItemsSource="{Binding RunningInstances}"
                      Margin="0,8,0,0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Extended"
                      MinHeight="100" MaxHeight="200"
                      ContextMenu="{StaticResource InstanceContextMenu}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                    <DataGridTextColumn Header="Runtime" Binding="{Binding Runtime}" Width="90" />
                    <DataGridTemplateColumn Header="" Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="Kill" Icon="Dismiss16" Appearance="Danger"
                                           Tag="{Binding ProcessId}" Click="KillInstance_Click" Padding="6,3" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <ui:Button Content="Refresh Instances" Icon="ArrowSync24" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="10,5"
                       Command="{Binding RefreshInstancesCommand}" />

            <!-- Features Grid: 2x2 -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Anti-AFK -->
                <Border Grid.Row="0" Grid.Column="0" Padding="12" Margin="0,0,8,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Anti-AFK" FontSize="14" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding AntiAfkEnabled, Mode=TwoWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Prevents disconnection due to inactivity" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding AntiAfkEnabled}">
                            <Slider Width="140" Minimum="30" Maximum="600" Value="{Binding AntiAfkIntervalSeconds}" TickFrequency="30" IsSnapToTickEnabled="True" />
                            <TextBlock Text="{Binding AntiAfkIntervalText}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <controls:OptionControl Header="Mouse Movement" Margin="0,4,0,0">
                            <ui:ToggleSwitch IsChecked="{Binding AntiAfkSimulateMouse, Mode=TwoWay}" />
                        </controls:OptionControl>
                        <controls:OptionControl Header="Key Press" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch IsChecked="{Binding AntiAfkSimulateKey, Mode=TwoWay}" />
                                <ComboBox ItemsSource="{Binding AntiAfkKeys}" SelectedItem="{Binding AntiAfkKeyToSend}" Margin="8,0,0,0" Width="80" IsEnabled="{Binding AntiAfkSimulateKey}" />
                            </StackPanel>
                        </controls:OptionControl>
                        <ui:Button Content="Toggle Anti-AFK" Icon="Clock24" Margin="0,8,0,0" Padding="10,5" Command="{Binding ToggleAntiAfkCommand}" />
                    </StackPanel>
                </Border>

                <!-- Screenshots -->
                <Border Grid.Row="0" Grid.Column="1" Padding="12" Margin="8,0,0,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                        IsEnabled="{Binding ScreenshotsEnabled}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Screenshots" FontSize="14" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding ScreenshotsEnabled, Mode=TwoWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Auto-capture running instances" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Interval" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding ScreenshotIntervals}" SelectedItem="{Binding ScreenshotIntervalSeconds}" Width="100" HorizontalAlignment="Left" />
                        <TextBlock Text="Save Location" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding ScreenshotSavePath}" 
                                        PlaceholderText="Default location" IsReadOnly="True" />
                            <ui:Button Grid.Column="1" Content="Browse" Icon="FolderOpen16" Margin="6,0,0,0" Padding="8,4"
                                       Command="{Binding BrowseScreenshotPathCommand}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:Button Content="Capture Now" Icon="Camera24" Margin="0,0,6,0" Padding="10,5"
                                       Command="{Binding CaptureNowCommand}" />
                            <TextBlock Text="{Binding ScreenshotStatusText}" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Auto-Relaunch + Anti-Detection -->
                <Border Grid.Row="1" Grid.Column="0" Padding="12" Margin="0,0,8,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Auto-Relaunch" FontSize="14" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding AutoRelaunchEnabled, Mode=TwoWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Restart crashed instances automatically" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding AutoRelaunchEnabled}">
                            <TextBlock Text="Delay:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                            <Slider Width="120" Minimum="1" Maximum="30" Value="{Binding AutoRelaunchDelaySeconds}" />
                            <TextBlock Text="{Binding AutoRelaunchDelayText}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>

                        <Separator Margin="0,10,0,10" />

                        <Grid>
                            <TextBlock Text="Anti-Detection" FontSize="14" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding AntiDetectionEnabled, Mode=TwoWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Randomize launch parameters" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        <StackPanel Margin="0,8,0,0" IsEnabled="{Binding AntiDetectionEnabled}">
                            <controls:OptionControl Header="Randomize User ID">
                                <ui:ToggleSwitch IsChecked="{Binding RandomizeUserId, Mode=TwoWay}" />
                            </controls:OptionControl>
                            <controls:OptionControl Header="Randomize Session ID">
                                <ui:ToggleSwitch IsChecked="{Binding RandomizeSessionId, Mode=TwoWay}" />
                            </controls:OptionControl>
                            <controls:OptionControl Header="Spoof Hardware ID">
                                <ui:ToggleSwitch IsChecked="{Binding SpoofHardwareId, Mode=TwoWay}" />
                            </controls:OptionControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dashboard + Logging -->
                <Border Grid.Row="1" Grid.Column="1" Padding="12" Margin="8,0,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Web Dashboard" FontSize="14" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding WebDashboardEnabled, Mode=TwoWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Monitor instances from browser (localhost)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        <StackPanel Margin="0,8,0,0" IsEnabled="{Binding WebDashboardEnabled}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Port:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                                <ui:TextBox Grid.Column="1" Text="{Binding WebDashboardPort}" Width="60" />
                                <ui:Button Grid.Column="2" Content="Open Dashboard" Icon="Globe16" Margin="8,0,0,0" Padding="10,5"
                                           Click="OpenDashboard_Click" />
                            </Grid>
                            <TextBlock Text="{Binding WebDashboardStatusText}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Separator Margin="0,12,0,12" />

                        <Grid>
                            <TextBlock Text="Instance Logging" FontSize="14" FontWeight="SemiBold" />
                            <ui:ToggleSwitch IsChecked="{Binding LoggingEnabled, Mode=TwoWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Track joins, leaves, errors per instance" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding LoggingEnabled}">
                            <ui:Button Content="Clear Logs" Icon="Delete16" Margin="0,0,6,0" Padding="8,4"
                                       Command="{Binding ClearLogsCommand}" />
                            <ui:Button Content="Export" Icon="ArrowDownload16" Padding="8,4"
                                       Command="{Binding ExportLogsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Mini Log -->
            <Border Margin="0,14,0,0" Padding="10" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" MaxHeight="120">
                <StackPanel>
                    <TextBlock Text="Recent Activity" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding InstanceName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</ui:UiPage>
