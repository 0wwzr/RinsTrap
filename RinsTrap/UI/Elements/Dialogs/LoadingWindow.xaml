<base:WpfUiWindow x:Class="RinsTrap.UI.Elements.Dialogs.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:RinsTrap.UI.Elements.Base"
        mc:Ignorable="d"
        Width="440"
        Height="210"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        Title="RinsTrap Updater">

    <Grid x:Name="MainGrid">
        <Grid.Resources>
            <Storyboard x:Key="DotAnimation" RepeatBehavior="Forever">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="1" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="0.35" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0.35" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.35" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0.35" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="0.35" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.35" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="0.35" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="0.35" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" ShowMinimize="False" ShowMaximize="False"
                     Title="" CanMaximize="False" Icon="pack://application:,,,/RinsTrap.ico" />

        <Border Grid.Row="1" Margin="18,8,18,18" Padding="0" CornerRadius="18"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid Margin="0,18,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Width="58" Height="58" HorizontalAlignment="Center"
                        CornerRadius="18" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="24" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Row="1" Text="RinsTrap" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />

                <TextBlock Grid.Row="2" x:Name="LoadingText" Text="Checking for updates..."
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,18">
                    <Ellipse x:Name="Dot1" Width="9" Height="9" Fill="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0" Opacity="1" />
                    <Ellipse x:Name="Dot2" Width="9" Height="9" Fill="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0" Opacity="0.35" />
                    <Ellipse x:Name="Dot3" Width="9" Height="9" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.35" />
                </StackPanel>

                <TextBlock Grid.Row="4" x:Name="DetailText" Text=""
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="300"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />

                <ui:ProgressBar Grid.Row="4" x:Name="ProgressBar" Width="300" Height="6"
                                IsIndeterminate="True" Visibility="Visible"
                                Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                Margin="0,0,0,14" />

                <ui:Button Grid.Row="4" x:Name="CloseButton" Content="Cancel" Icon="Dismiss24"
                           Margin="0,52,0,0" Padding="18,8" HorizontalAlignment="Center"
                           Background="Transparent" Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                           BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                           Click="CloseButton_Click" Cursor="Hand"
                           FontSize="12" FontWeight="Medium" />
            </Grid>
        </Border>
    </Grid>
</base:WpfUiWindow>