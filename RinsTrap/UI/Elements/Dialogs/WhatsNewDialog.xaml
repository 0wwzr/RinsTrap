<base:WpfUiWindow x:Class="RinsTrap.UI.Elements.Dialogs.WhatsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:RinsTrap.UI.Elements.Base"
        xmlns:controls="clr-namespace:RinsTrap.UI.Elements.Controls"
        xmlns:resources="clr-namespace:RinsTrap.Resources"
        mc:Ignorable="d"
        Width="560"
        Height="520"
        MinWidth="420"
        MinHeight="360"
        Title="{x:Static resources:Strings.Dialog_WhatsNew_Title}"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" x:Name="RootTitleBar" />

        <Grid Grid.Row="1" Margin="16,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,12">
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="22" Foreground="White" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTextBlock" FontSize="18" FontWeight="Medium" />
                    <TextBlock x:Name="SubHeaderTextBlock" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <controls:MarkdownTextBlock x:Name="ChangelogTextBlock" MarkdownText="" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="15" Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" MinWidth="100" Content="{x:Static resources:Strings.Common_Close}" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
